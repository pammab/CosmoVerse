+  const along = (pts, t) => { const s = t * (pts.length - 1), i = Math.min(pts.length - 2, Math.floor(s)), f = s - i, a = pts[i], c = pts[i + 1]; return [a[0] + (c[0] - a[0]) * f, a[1] + (c[1] - a[1]) * f, a[2] + (c[2] - a[2]) * f]; };
