+      const t2 = th + (r() < 0.5 ? -1 : 1) * (0.35 + r() * 0.3), r2 = 0.55 + r() * 0.3;
+      paths.push([[Math.cos(t2) * r2, gauss(r) * flat * 0.4, Math.sin(t2) * r2], mid]);
